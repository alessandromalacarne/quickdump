generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id        String   @id @default(uuid(7))
  content   String
  createdAt DateTime @default(now())
  groups    Group[]
}

model Group {
  id    String @id @default(uuid(7))
  name  String @unique
  notes Note[]
}

model User {
    id           String @id @default(uuid(7))
    email        String @unique
    passwordHash String 
}
