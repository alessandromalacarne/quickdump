generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Dump {
  id        String   @id @default(uuid(7))
  content   String
  createdAt DateTime @default(now())
  decks     Deck[]
}

model Deck {
  id    String @id @default(uuid(7))
  name  String @unique
  dumps Dump[]
}

model User {
    id           String @id @default(uuid(7))
    email        String @unique
    passwordHash String 
}
