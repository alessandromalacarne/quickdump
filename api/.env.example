# Works with both compose.yaml at the repo root and scripts/pg.sh (local nix)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickdump"
PORT=3000

# Interface the API binds to. Defaults to 127.0.0.1: workflows can run any
# script in the scripts directory, so anyone who can reach the API can run
# commands on this machine.
# HOST=0.0.0.0

# Where the scripts offered to workflows live (defaults to <repo>/scripts/workflows)
# QUICKDUMP_SCRIPTS_DIR="/home/me/.quickdump/scripts"

# Where export workflows write their plain text files (defaults to ~/.quickdump/exports)
# QUICKDUMP_EXPORT_DIR="/home/me/.quickdump/exports"

# Set to "off" to disable the scheduled-run poller
# QUICKDUMP_SCHEDULER=off
